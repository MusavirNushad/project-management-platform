generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  PENDING
  GENERATED
  FAILED
}

enum NotificationType {
  GENERAL
  TASK_ASSIGNED
  TASK_UPDATED
  COMMENT_ADDED
  STATUS_CHANGED
  PROJECT_UPDATED
  SPRINT_UPDATED
}

enum ActivityEntityType {
  USER
  WORKSPACE
  PROJECT
  TASK
  COMMENT
  SPRINT
  REPORT
}

/**
 * =========================
 * USERS / IDENTITY
 * =========================
 */

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile UserProfile?

  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")

  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]

  createdProjects Project[] @relation("ProjectCreator")
  createdSprints  Sprint[]  @relation("SprintCreator")
  createdReports  Report[]  @relation("ReportCreator")

  reportedTasks Task[] @relation("TaskReporter")
  assignedTasks Task[] @relation("SingleTaskAssignee")

  taskAssignments     TaskAssignee[] @relation("AssignedUser")
  taskAssignmentsMade TaskAssignee[] @relation("AssignedByUser")

  comments Comment[]

  sentNotifications     Notification[] @relation("NotificationActor")
  receivedNotifications Notification[] @relation("NotificationRecipient")

  worklogs Worklog[]

  taskStatusChanges TaskStatusHistory[]

  activityLogs ActivityLog[]

  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  phoneNumber String?  @map("phone_number")
  designation String?
  address     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/**
 * =========================
 * ROLES / PERMISSIONS
 * =========================
 */

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/**
 * =========================
 * WORKSPACES
 * =========================
 */

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  members  WorkspaceMember[]
  projects Project[]

  tasks         Task[]
  taskAssignees TaskAssignee[]

  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  joinedAt    DateTime @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role      @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("workspace_members")
}

/**
 * =========================
 * PROJECTS
 * =========================
 */

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  createdById String        @map("created_by") @db.Uuid
  title       String
  status      ProjectStatus @default(ACTIVE)
  description String?
  startDate   DateTime?     @map("start_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy User      @relation("ProjectCreator", fields: [createdById], references: [id])

  members ProjectMember[]

  sprints Sprint[]
  tasks   Task[]

  taskAssignees TaskAssignee[]

  reports       Report[]
  worklogs      Worklog[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([workspaceId])
  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("project_members")
}

/**
 * =========================
 * SPRINTS
 * =========================
 */

model Sprint {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  createdById String       @map("created_by") @db.Uuid
  name        String
  goal        String?
  status      SprintStatus @default(PLANNED)
  startDate   DateTime?    @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SprintCreator", fields: [createdById], references: [id])

  sprintTasks SprintTask[]

  @@index([projectId])
  @@index([createdById])
  @@map("sprints")
}

model SprintTask {
  id        String    @id @default(uuid()) @db.Uuid
  sprintId  String    @map("sprint_id") @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  position  Int?
  addedAt   DateTime  @default(now()) @map("added_at")
  removedAt DateTime? @map("removed_at")

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Restrict)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId], where: { removedAt: null }, map: "sprint_tasks_one_active_sprint_per_task")
  @@index([sprintId])
  @@index([taskId])
  @@index([sprintId, removedAt, position])
  @@index([taskId, removedAt])
  @@map("sprint_tasks")
}

/**
 * =========================
 * TASKS
 * =========================
 */

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  reporterId  String  @map("reporter_id") @db.Uuid
  assigneeId  String? @map("assignee_id") @db.Uuid

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  isCompleted Boolean   @default(false) @map("is_completed")

  attachments Json @default("[]") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  reporter User  @relation("TaskReporter", fields: [reporterId], references: [id])
  assignee User? @relation("SingleTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  assignees     TaskAssignee[]
  comments      Comment[]
  sprintTasks   SprintTask[]
  worklogs      Worklog[]
  statusHistory TaskStatusHistory[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}

model TaskAssignee {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedById String   @map("assigned_by") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  task       Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  user       User      @relation("AssignedUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User      @relation("AssignedByUser", fields: [assignedById], references: [id])
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([assignedById])
  @@index([workspaceId])
  @@index([projectId])
  @@map("task_assignees")
}

/**
 * =========================
 * COMMENTS
 * =========================
 */

model Comment {
  id              String  @id @default(uuid()) @db.Uuid
  taskId          String  @map("task_id") @db.Uuid
  authorId        String  @map("author_id") @db.Uuid
  parentCommentId String? @map("parent_comment_id") @db.Uuid
  body            String  @db.Text

  attachments Json @default("[]") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Restrict)
  replies       Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([authorId])
  @@index([parentCommentId])
  @@map("comments")
}

/**
 * =========================
 * NOTIFICATIONS
 * =========================
 */

model Notification {
  id          String  @id @default(uuid()) @db.Uuid
  actorId     String? @map("actor_id") @db.Uuid
  recipientId String  @map("recipient_id") @db.Uuid

  workspaceId String? @map("workspace_id") @db.Uuid
  projectId   String? @map("project_id") @db.Uuid
  taskId      String? @map("task_id") @db.Uuid

  title   String
  type    NotificationType
  message String           @db.Text
  source  String?
  readAt  DateTime?        @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([recipientId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([readAt])
  @@map("notifications")
}

/**
 * =========================
 * REPORTS
 * =========================
 */

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  createdById String       @map("created_by") @db.Uuid
  name        String
  file        String?
  status      ReportStatus @default(PENDING)
  startDate   DateTime?    @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ReportCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([createdById])
  @@map("reports")
}

/**
 * =========================
 * WORKLOGS
 * =========================
 */

model Worklog {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  taskId    String @map("task_id") @db.Uuid

  startedAt   DateTime  @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationMin Int?      @map("duration_min")
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([startedAt])
  @@map("worklogs")
}

/**
 * =========================
 * TASK STATUS HISTORY
 * =========================
 */

model TaskStatusHistory {
  id          String     @id @default(uuid()) @db.Uuid
  taskId      String     @map("task_id") @db.Uuid
  changedById String     @map("changed_by") @db.Uuid
  fromStatus  TaskStatus @map("from_status")
  toStatus    TaskStatus @map("to_status")
  changedAt   DateTime   @default(now()) @map("changed_at")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([taskId])
  @@index([changedById])
  @@index([changedAt])
  @@map("task_status_history")
}

/**
 * =========================
 * ACTIVITY LOGS
 * =========================
 */

model ActivityLog {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String? @map("workspace_id") @db.Uuid
  projectId   String? @map("project_id") @db.Uuid
  taskId      String? @map("task_id") @db.Uuid
  actorId     String  @map("actor_id") @db.Uuid

  action     String
  entityId   String             @map("entity_id") @db.Uuid
  entityType ActivityEntityType @map("entity_type")
  metadata   Json?

  createdAt DateTime @default(now()) @map("created_at")

  actor     User       @relation(fields: [actorId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
